# GitHub App local development configuration.
# Copy this file to .env and replace placeholders locally.
# Never commit .env, client secrets, or private keys.

GITHUB_APP_SLUG=webtoapp-integration
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-client-secret
GITHUB_PRIVATE_KEY_PATH=./secrets/webtoapp-integration.private-key.pem
GITHUB_CALLBACK_URL=http://127.0.0.1:3000/api/integrations/github/callback
